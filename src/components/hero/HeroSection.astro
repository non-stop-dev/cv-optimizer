---
import DocumentUploader from './DocumentUploader.astro';
---

<section class="relative mx-auto w-full max-w-5xl px-6 pb-8 pt-12 md:px-10 md:pb-14 md:pt-16">
	<div class="fade-up relative overflow-hidden">

		<div class="relative space-y-6">
			<div class="space-y-3">
				<h1 class="max-w-3xl text-4xl font-extrabold leading-tight text-(--ink-strong) md:text-5xl">
					Haz que tu CV destaque en cada proceso de selección
				</h1>
				<p class="max-w-2xl text-base leading-relaxed text-(--ink-soft) md:text-lg">
					Sube tu documento, valídalo de forma segura y prepáralo para sobresalir frente a reclutadores.
				</p>
			</div>

			<DocumentUploader />
		</div>
	</div>
</section>
