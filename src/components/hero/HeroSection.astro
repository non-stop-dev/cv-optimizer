---
import DocumentUploader from './DocumentUploader.astro';
---

<section class="landing-shell relative px-6 pb-8 pt-12 md:px-10 md:pb-14 md:pt-16">
	<div class="fade-up brutal-paper px-6 py-7 sm:px-8 sm:py-8 md:px-10 md:py-10">
		<div class="relative z-10 space-y-6">
			<div class="space-y-3">
				<h1 class="max-w-4xl text-balance text-4xl font-black uppercase leading-[0.94] text-(--ink-strong) md:text-5xl lg:text-6xl">
					Haz que tu CV destaque en cada proceso de selección
				</h1>
				<p class="max-w-3xl text-base leading-relaxed text-(--ink-soft) md:text-lg">
					Sube tu documento, valídalo de forma segura y prepáralo para sobresalir frente a reclutadores.
				</p>
			</div>

			<DocumentUploader />
		</div>
	</div>
</section>
