---
import '../../styles/cv-templates/document-upload-preview.css';
---

<section class="fade-up-delay flex flex-col gap-5 text-left" aria-label="Carga de documento">
	<form
		data-upload-form
		class="brutal-card flex w-full flex-col gap-5 p-5 md:p-6"
	>
		<div class="space-y-2 text-center sm:text-left">
			<label for="cv-document" class="font-mono text-[0.72rem] font-black uppercase tracking-[0.24em] text-(--ink-soft)">
				Sube tu CV
			</label>
			<p class="text-sm leading-relaxed text-(--ink-soft)">
				Formatos permitidos: PDF, HTML, YAML, YML y TXT. Tamaño máximo: 10 MB.
			</p>
		</div>

		<input
			id="cv-document"
			name="document"
			type="file"
			accept=".pdf,.html,.yaml,.yml,.txt"
			required
			data-upload-input
			class="sr-only"
		/>

		<label
			for="cv-document"
			data-upload-picker
			class="brutal-control mx-auto flex w-full max-w-2xl items-center justify-between gap-4 bg-(--paper-muted) px-4 py-4 text-sm font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
		>
			<span class="brutal-chip shrink-0 bg-(--note-mint) px-4 py-2 text-[0.68rem] text-(--ink-strong)">
				Choose File
			</span>
			<span data-upload-file-name class="min-w-0 truncate text-center text-xs text-(--ink-soft) sm:text-sm">
				No file chosen
			</span>
		</label>

		<div
			data-target-positions-shell
			class="mx-auto flex w-full max-w-2xl flex-col gap-2 bg-white p-4 text-left"
		>
			<label for="target-position-input" class="font-mono text-[0.72rem] font-black uppercase tracking-[0.24em] text-(--ink-soft)">
				Posición objetivo (opcional)
			</label>
			<p class="text-xs leading-relaxed text-(--ink-soft)">
				Escribe una o varias posiciones separadas por comas. Ejemplo: Analista de datos, Científico de
				datos.
			</p>
			<p class="text-xs leading-relaxed text-(--ink-soft)">
				Mientras más específica y menos variable sea tu selección, mejores resultados obtendrás. Evita
				combinar rubros que no se pueden compatibilizar (por ejemplo: Analista de datos y Cocinero).
			</p>

			<input
				id="target-position-input"
				type="text"
				data-target-position-input
				autocomplete="off"
				placeholder="Ejemplo: Analista de datos, BI Analyst"
				class="brutal-field px-4 py-3 text-sm placeholder:text-(--ink-soft)"
			/>
			<input type="hidden" name="targetPositions" data-target-positions-hidden value="[]" />

			<p data-target-positions-feedback class="text-xs text-(--ink-soft)" aria-live="polite">
				Puedes agregar hasta 3 posiciones.
			</p>
			<ul data-target-positions-chips class="flex flex-wrap gap-2" aria-label="Posiciones seleccionadas"></ul>
		</div>

		<div class="mx-auto flex w-full flex-col items-center gap-3 sm:flex-row sm:justify-center">
			<button
				type="submit"
				data-upload-submit
				class="brutal-button brutal-button--accent w-full px-6 py-4 text-sm uppercase tracking-[0.08em] sm:w-auto md:px-12"
			>
				Generar CV optimizado
			</button>

			<button
				type="button"
				data-upload-retry
				hidden
				class="brutal-button w-full px-6 py-4 text-sm uppercase tracking-[0.08em] sm:w-auto md:px-12"
			>
				Reintentar
			</button>
		</div>
	</form>

	<aside
		data-upload-status
		hidden
		class="brutal-card w-full p-5 text-left text-sm text-(--ink-strong)"
		aria-live="polite"
	>
		<h3 data-upload-status-title class="text-base font-bold"></h3>
		<p data-upload-status-message class="mt-2 text-(--ink-soft)"></p>
		<ul data-upload-log-list class="mt-4 space-y-2"></ul>
	</aside>

	<section
		data-upload-result
		hidden
		class="w-full p-1 text-left"
	>
		<h3 class="font-mono text-[0.72rem] font-black uppercase tracking-[0.24em] text-(--brand-optimizer)">
			CV optimizado por IA
		</h3>
		<div data-cv-editor-controls class="mt-3 flex flex-wrap items-center gap-3">
			<label
				for="cv-primary-color"
				class="brutal-control items-center gap-2 px-3 py-2 text-xs font-semibold uppercase tracking-[0.08em] text-(--ink-soft)"
			>
				Color principal
				<input
					id="cv-primary-color"
					type="color"
					value="#0f766e"
					data-cv-primary-color
					class="h-7 w-7 cursor-pointer rounded border-0 bg-transparent p-0"
				/>
			</label>
			<button
				type="button"
				data-cv-export-html
				class="brutal-control px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
			>
				Exportar HTML
			</button>
			<button
				type="button"
				data-cv-export-txt
				class="brutal-control px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
			>
				Exportar TXT
			</button>
			<button
				type="button"
				data-cv-export-pdf
				class="brutal-control group relative gap-2 px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
			>
				<span>Exportar PDF</span>
				<span
					data-pdf-help-trigger
					aria-hidden="true"
					class="inline-flex h-4 w-4 items-center justify-center text-(--ink-soft)"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-info"
					>
						<circle cx="12" cy="12" r="10"></circle>
						<path d="M12 16v-4"></path>
						<path d="M12 8h.01"></path>
					</svg>
				</span>
				<span
					data-pdf-help-tooltip
					role="tooltip"
					class="brutal-tooltip pointer-events-none invisible absolute left-1/2 top-full z-20 mt-3 w-72 -translate-x-1/2 px-3 py-2 text-[11px] font-medium normal-case tracking-normal leading-relaxed text-(--ink-soft) opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
				>
					La exportación PDF se realiza mediante la vista de impresión del navegador. Si no se abre automáticamente,
					usa Cmd/Ctrl+P y guarda como PDF.
				</span>
			</button>
		</div>
		<p class="mt-2 text-xs text-(--ink-soft)">
			Vista editable: puedes ajustar texto y estructura antes de exportar.
		</p>
		<div
			data-upload-result-preview
			contenteditable="true"
			spellcheck="true"
			class="mt-3 max-h-[70vh] overflow-auto border-2 border-(--line) bg-white p-6 text-sm text-(--ink-strong) shadow-[6px_6px_0_var(--shadow)]"
		></div>
		<details class="mt-3">
			<summary class="cursor-pointer text-sm font-semibold text-(--ink-soft)">Ver HTML generado</summary>
			<pre
				data-upload-result-raw
				class="mt-2 max-h-64 overflow-auto border-2 border-(--line) bg-white p-3 text-xs text-(--ink-soft) shadow-[4px_4px_0_var(--shadow)]"
			></pre>
		</details>
	</section>

	<section data-upload-history class="w-full p-1 text-left">
		<div class="flex flex-wrap items-end justify-between gap-2">
			<div>
				<h3 class="font-mono text-[0.72rem] font-black uppercase tracking-[0.24em] text-(--ink-strong)">Historial local</h3>
				<p class="mt-1 text-xs text-(--ink-soft)">
					Guardamos versiones en este navegador para reabrirlas sin volver a subir el archivo.
				</p>
			</div>
			<button
				type="button"
				data-upload-history-clear
				class="brutal-control px-3 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
			>
				Limpiar historial
			</button>
		</div>
		<p data-upload-history-empty class="mt-3 text-sm text-(--ink-soft)">
			Aún no hay versiones guardadas.
		</p>
		<ul data-upload-history-list class="mt-3 space-y-2"></ul>
	</section>
</section>

<script>
	import '../../server/browser-memory/document-uploader.client';
</script>
