<section class="fade-up-delay flex flex-col items-center space-y-4 text-center" aria-label="Carga de documento">
	<form
		data-upload-form
		class="glass-card flex w-full flex-col items-center space-y-4 rounded-2xl border border-(--line) p-5 text-center md:p-6"
	>
		<div class="space-y-2">
			<label for="cv-document" class="text-base font-semibold text-(--ink-strong)">
				Sube tu CV
			</label>
			<p class="text-sm text-(--ink-soft)">
				Formatos permitidos: PDF, HTML, YAML, YML y TXT. Tamano maximo: 10 MB.
			</p>
		</div>

		<input
			id="cv-document"
			name="document"
			type="file"
			accept=".pdf,.html,.yaml,.yml,.txt"
			required
			data-upload-input
			class="sr-only"
		/>

		<label
			for="cv-document"
			data-upload-picker
			class="mx-auto flex w-full max-w-2xl items-center justify-center gap-4 rounded-xl border border-(--line) bg-(--surface) px-4 py-3 text-sm font-medium text-(--ink-soft)"
		>
			<span
				class="inline-flex shrink-0 rounded-lg bg-(--brand-optimizer) px-4 py-2 text-sm font-semibold text-white"
			>
				Choose File
			</span>
			<span data-upload-file-name class="truncate text-center">No file chosen</span>
		</label>

		<div class="mx-auto flex w-full flex-col items-center gap-3 sm:flex-row sm:justify-center">
			<button
				type="submit"
				data-upload-submit
				class="inline-flex w-full items-center justify-center rounded-xl bg-(--brand-cv) px-6 py-4 text-sm font-bold uppercase tracking-[0.08em] text-white transition hover:brightness-110 sm:w-auto md:px-12"
			>
				Subir
			</button>

			<button
				type="button"
				data-upload-retry
				hidden
				class="inline-flex w-full items-center justify-center rounded-xl border border-(--line) bg-white px-6 py-4 text-sm font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface) sm:w-auto md:px-12"
			>
				Reintentar
			</button>
		</div>
	</form>

	<aside
		data-upload-status
		hidden
		class="w-full rounded-2xl border border-(--line) bg-white/80 p-5 text-left text-sm text-(--ink-strong)"
		aria-live="polite"
	>
		<h3 data-upload-status-title class="text-base font-bold"></h3>
		<p data-upload-status-message class="mt-2 text-(--ink-soft)"></p>
		<ul data-upload-log-list class="mt-4 space-y-2"></ul>
	</aside>

	<section
		data-upload-result
		hidden
		class="w-full rounded-2xl border border-(--line) bg-white/85 p-5 text-left"
	>
		<h3 class="text-base font-bold text-(--ink-strong)">CV optimizado por IA</h3>
		<div data-cv-editor-controls class="mt-3 flex flex-wrap items-center gap-3">
			<label
				for="cv-primary-color"
				class="inline-flex items-center gap-2 rounded-lg border border-(--line) bg-white px-3 py-2 text-xs font-semibold uppercase tracking-[0.08em] text-(--ink-soft)"
			>
				Color principal
				<input
					id="cv-primary-color"
					type="color"
					value="#0f766e"
					data-cv-primary-color
					class="h-7 w-7 cursor-pointer rounded border-0 bg-transparent p-0"
				/>
			</label>
			<button
				type="button"
				data-cv-export-html
				class="inline-flex items-center justify-center rounded-lg border border-(--line) bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
			>
				Exportar HTML
			</button>
			<button
				type="button"
				data-cv-export-txt
				class="inline-flex items-center justify-center rounded-lg border border-(--line) bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
			>
				Exportar TXT
			</button>
			<button
				type="button"
				data-cv-export-pdf
				class="group relative inline-flex items-center justify-center gap-2 rounded-lg border border-(--line) bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--brand-optimizer)"
			>
				<span>Exportar PDF</span>
				<span
					data-pdf-help-trigger
					aria-hidden="true"
					class="inline-flex h-4 w-4 items-center justify-center text-(--ink-soft)"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-info"
					>
						<circle cx="12" cy="12" r="10"></circle>
						<path d="M12 16v-4"></path>
						<path d="M12 8h.01"></path>
					</svg>
				</span>
				<span
					data-pdf-help-tooltip
					role="tooltip"
					class="pointer-events-none invisible absolute left-1/2 top-full z-20 mt-2 w-72 -translate-x-1/2 rounded-lg border border-(--line) bg-white px-3 py-2 text-[11px] normal-case font-medium tracking-normal leading-relaxed text-(--ink-soft) opacity-0 shadow-[0_12px_24px_rgba(12,22,26,0.12)] transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
				>
					La exportacion PDF se realiza mediante la vista de impresion del navegador. Si no se abre automaticamente,
					usa Cmd/Ctrl+P y guarda como PDF.
				</span>
			</button>
		</div>
		<p class="mt-2 text-xs text-(--ink-soft)">
			Vista editable: puedes ajustar texto y estructura antes de exportar.
		</p>
		<div
			data-upload-result-preview
			contenteditable="true"
			spellcheck="true"
			class="mt-3 max-h-[70vh] overflow-auto rounded-xl border border-(--line) bg-white p-6 text-sm text-(--ink-strong)"
		></div>
		<details class="mt-3">
			<summary class="cursor-pointer text-sm font-semibold text-(--ink-soft)">Ver HTML generado</summary>
			<pre
				data-upload-result-raw
				class="mt-2 max-h-64 overflow-auto rounded-xl border border-(--line) bg-white p-3 text-xs text-(--ink-soft)"
			></pre>
		</details>
	</section>

	<section data-upload-history class="w-full rounded-2xl border border-(--line) bg-white/75 p-5 text-left">
		<div class="flex flex-wrap items-end justify-between gap-2">
			<div>
				<h3 class="text-base font-bold text-(--ink-strong)">Historial local</h3>
				<p class="mt-1 text-xs text-(--ink-soft)">
					Guardamos versiones en este navegador para reabrirlas sin volver a subir el archivo.
				</p>
			</div>
			<button
				type="button"
				data-upload-history-clear
				class="inline-flex items-center justify-center rounded-lg border border-(--line) bg-white px-3 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
			>
				Limpiar historial
			</button>
		</div>
		<p data-upload-history-empty class="mt-3 text-sm text-(--ink-soft)">
			Aun no hay versiones guardadas.
		</p>
		<ul data-upload-history-list class="mt-3 space-y-2"></ul>
	</section>
</section>

<style is:global>
	[data-upload-status][data-tone='proceso'] {
		border-color: color-mix(in srgb, var(--brand-optimizer), white 35%);
		background: color-mix(in srgb, var(--brand-optimizer), white 92%);
	}

	[data-upload-status][data-tone='exito'] {
		border-color: color-mix(in srgb, var(--brand-optimizer), white 20%);
		background: color-mix(in srgb, var(--brand-optimizer), white 88%);
	}

	[data-upload-status][data-tone='error'] {
		border-color: color-mix(in srgb, var(--brand-cv), white 20%);
		background: color-mix(in srgb, var(--brand-cv), white 90%);
	}

	[data-upload-log-list] {
		list-style: none;
		padding: 0;
	}

	[data-upload-log-item] {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		border: 1px solid color-mix(in srgb, var(--line), white 18%);
		border-radius: 0.7rem;
		background: rgba(255, 255, 255, 0.76);
		padding: 0.48rem 0.65rem;
		font-size: 0.9rem;
		color: var(--ink-soft);
		animation: upload-log-enter 0.24s ease-out;
	}

	[data-upload-log-item]::before {
		content: '';
		display: inline-grid;
		place-items: center;
		height: 0.9rem;
		width: 0.9rem;
		border-radius: 999px;
		font-size: 0.62rem;
		font-weight: 900;
		line-height: 1;
		background: color-mix(in srgb, var(--brand-optimizer), white 28%);
	}

	[data-upload-log-item][data-state='en-progreso'] {
		color: var(--ink-strong);
		font-weight: 700;
	}

	[data-upload-log-item][data-state='en-progreso']::before {
		background: transparent;
		border: 2px solid color-mix(in srgb, var(--brand-optimizer), white 45%);
		border-top-color: var(--brand-optimizer);
		animation: upload-spin 0.8s linear infinite;
	}

	[data-upload-log-item][data-state='completado']::before {
		background: var(--brand-optimizer);
		color: white;
		content: '✓';
		border: 0;
	}

	[data-upload-log-item][data-state='error']::before {
		background: var(--brand-cv);
		color: white;
		content: '×';
		border: 0;
	}

	[data-upload-input]:focus-visible + [data-upload-picker] {
		outline: 2px solid color-mix(in srgb, var(--brand-optimizer), white 15%);
		outline-offset: 2px;
	}

	[data-upload-result-preview] {
		--cv-primary: #0f766e;
		--cv-ink: #1a2a2f;
		--cv-soft: #41545c;
		line-height: 1.55;
		font-size: 0.98rem;
		color: var(--cv-ink);
	}

	[data-upload-result-preview]:focus {
		outline: 2px solid color-mix(in srgb, var(--cv-primary), white 38%);
		outline-offset: 2px;
	}

	[data-upload-result-preview] h1 {
		margin: 0;
		font-size: clamp(1.8rem, 2.6vw, 2.35rem);
		line-height: 1.15;
		color: var(--cv-ink);
	}

	[data-upload-result-preview] h2 {
		margin: 1.35rem 0 0.55rem;
		padding-bottom: 0.35rem;
		border-bottom: 2px solid color-mix(in srgb, var(--cv-primary), white 65%);
		font-size: 1.06rem;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		color: var(--cv-primary);
	}

	[data-upload-result-preview] h3 {
		margin: 1rem 0 0.3rem;
		font-size: 1.02rem;
		color: color-mix(in srgb, var(--cv-primary), var(--cv-ink) 52%);
	}

	[data-upload-result-preview] p {
		margin: 0.35rem 0;
		color: var(--cv-soft);
	}

	[data-upload-result-preview] section {
		margin-top: 1rem;
		padding-left: 0.8rem;
		border-left: 3px solid color-mix(in srgb, var(--cv-primary), white 76%);
	}

	[data-upload-result-preview] ul,
	[data-upload-result-preview] ol {
		margin: 0.45rem 0 0.75rem;
		padding-left: 1.1rem;
	}

	[data-upload-result-preview] li {
		margin: 0.2rem 0;
		color: var(--cv-soft);
	}

	[data-upload-result-preview] strong {
		color: var(--cv-ink);
	}

	[data-upload-result-preview] .cv-placeholder {
		display: inline-block;
		margin: 0 0.15rem;
		padding: 0.1rem 0.42rem;
		border-radius: 0.35rem;
		font-weight: 800;
		letter-spacing: 0.01em;
	}

	[data-upload-result-preview] .cv-placeholder-critical {
		color: #9f1239;
		background: #ffe4e6;
		border: 1px solid #fb7185;
	}

	[data-upload-result-preview] a {
		color: color-mix(in srgb, var(--cv-primary), #0a3a35 18%);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	[data-upload-result-preview] hr {
		margin: 1rem 0;
		border: 0;
		border-top: 1px solid color-mix(in srgb, var(--cv-primary), white 70%);
	}

	[data-upload-history-list] {
		list-style: none;
		padding: 0;
	}

	[data-upload-history-item] {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		border: 1px solid color-mix(in srgb, var(--line), white 18%);
		border-radius: 0.85rem;
		background: rgba(255, 255, 255, 0.84);
		padding: 0.7rem 0.85rem;
	}

	[data-history-meta] {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	[data-history-file] {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--ink-strong);
		word-break: break-word;
	}

	[data-history-info] {
		font-size: 0.78rem;
		color: var(--ink-soft);
	}

	[data-history-load-button] {
		border: 1px solid color-mix(in srgb, var(--line), white 4%);
		border-radius: 0.7rem;
		background: white;
		padding: 0.45rem 0.8rem;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink-strong);
		cursor: pointer;
	}

	[data-history-load-button]:hover {
		background: var(--surface);
	}

	@keyframes upload-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes upload-log-enter {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	import DOMPurify from 'dompurify';

	const MAX_SIZE_BYTES = 10 * 1024 * 1024;
	const ALLOWED_EXTENSIONS = new Set(['.pdf', '.html', '.yaml', '.yml', '.txt']);
	const HISTORY_DB_NAME = 'cv-optimizer-browser-memory';
	const HISTORY_STORE_NAME = 'cv-history';
	const HISTORY_MAX_ENTRIES = 20;
	const PROCESS_STAGES = {
		validating: 'Validando documento localmente',
		uploading: 'Subiendo documento al servidor',
		optimizing: 'Optimizando CV con IA',
		rendering: 'Renderizando resultado'
	};
	const PREVIEW_SELECTOR = '[data-upload-result-preview]';
	const DEFAULT_PRIMARY_COLOR = '#0f766e';

	type StageKey = keyof typeof PROCESS_STAGES;
	type StageState = 'en-progreso' | 'completado' | 'error';
	type StatusTone = 'proceso' | 'exito' | 'error';

	interface HistoryEntry {
		id: string;
		createdAt: number;
		sourceFileName: string;
		safeFileName: string;
		format: string;
		inputSizeInBytes: number;
		inputFile?: File;
		summary: string;
		contentHash: string;
		optimizedHTML: string;
		primaryColor: string;
	}

	interface SaveHistoryPayload {
		sourceFileName: string;
		safeFileName: string;
		format: string;
		inputSizeInBytes: number;
		inputFile: File;
		summary: string;
		contentHash: string;
		optimizedHTML: string;
		primaryColor: string;
	}

	const toOptimizerResultPath = (historyId: string): string => {
		return `/optimizer/${encodeURIComponent(historyId)}`;
	};

	const form = document.querySelector('[data-upload-form]');
	const input = document.querySelector('[data-upload-input]');
	const fileNameLabel = document.querySelector('[data-upload-file-name]');
	const submitButton = document.querySelector('[data-upload-submit]');
	const retryButton = document.querySelector('[data-upload-retry]');
	const statusContainer = document.querySelector('[data-upload-status]');
	const statusTitle = document.querySelector('[data-upload-status-title]');
	const statusMessage = document.querySelector('[data-upload-status-message]');
	const statusLogList = document.querySelector('[data-upload-log-list]');
	const resultContainer = document.querySelector('[data-upload-result]');
	const resultPreview = document.querySelector('[data-upload-result-preview]');
	const resultRaw = document.querySelector('[data-upload-result-raw]');
	const historyList = document.querySelector('[data-upload-history-list]');
	const historyEmpty = document.querySelector('[data-upload-history-empty]');
	const historyClearButton = document.querySelector('[data-upload-history-clear]');
	const cvPrimaryColorPicker = document.querySelector('[data-cv-primary-color]');
	const exportHtmlButton = document.querySelector('[data-cv-export-html]');
	const exportTxtButton = document.querySelector('[data-cv-export-txt]');
	const exportPdfButton = document.querySelector('[data-cv-export-pdf]');

	if (
		!(form instanceof HTMLFormElement) ||
		!(input instanceof HTMLInputElement) ||
		!(fileNameLabel instanceof HTMLElement) ||
		!(submitButton instanceof HTMLButtonElement) ||
		!(retryButton instanceof HTMLButtonElement) ||
		!(statusContainer instanceof HTMLElement) ||
		!(statusTitle instanceof HTMLElement) ||
		!(statusMessage instanceof HTMLElement) ||
		!(statusLogList instanceof HTMLElement) ||
		!(resultContainer instanceof HTMLElement) ||
		!(resultPreview instanceof HTMLElement) ||
		!(resultRaw instanceof HTMLElement) ||
		!(historyList instanceof HTMLElement) ||
		!(historyEmpty instanceof HTMLElement) ||
		!(historyClearButton instanceof HTMLButtonElement) ||
		!(cvPrimaryColorPicker instanceof HTMLInputElement) ||
		!(exportHtmlButton instanceof HTMLButtonElement) ||
		!(exportTxtButton instanceof HTMLButtonElement) ||
		!(exportPdfButton instanceof HTMLButtonElement)
	) {
		throw new Error('No se pudo inicializar el componente de carga de documentos.');
	}

	const stageNodes = new Map<StageKey, HTMLElement>();
	let activeStageKey: StageKey | null = null;
	let lastSelectedFile: File | null = null;
	let currentDocumentBaseName = 'cv-optimizado';
	let historyEntries: HistoryEntry[] = [];

	class UploadFlowError extends Error {
		code: string;

		constructor(message: string, code = 'UNKNOWN') {
			super(message);
			this.name = 'UploadFlowError';
			this.code = code;
		}
	}

	const CV_SANITIZE_CONFIG = {
		ALLOWED_TAGS: [
			'h1',
			'h2',
			'h3',
			'h4',
			'h5',
			'h6',
			'p',
			'div',
			'span',
			'section',
			'article',
			'strong',
			'em',
			'b',
			'i',
			'u',
			'ul',
			'ol',
			'li',
			'br',
			'hr',
			'a',
			'table',
			'thead',
			'tbody',
			'tr',
			'th',
			'td'
		],
		ALLOWED_ATTR: ['href', 'title', 'target', 'rel', 'class'],
		ALLOW_DATA_ATTR: false,
		ALLOW_UNKNOWN_PROTOCOLS: false,
		ALLOWED_URI_REGEXP: /^(?:(?:https?|mailto|tel):|[^a-z]|[a-z+.-]+(?:[^a-z+.-:]|$))/i
	};

	const sanitizeCvHtml = (html: string): string => {
		if (typeof html !== 'string' || html.length === 0) {
			return '';
		}

		return DOMPurify.sanitize(html, CV_SANITIZE_CONFIG);
	};

	const isValidHexColor = (value: string): boolean => {
		return /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(value);
	};

	const findPreviewRule = (rules: CSSRuleList): CSSStyleRule | null => {
		for (const rule of Array.from(rules)) {
			if (rule instanceof CSSStyleRule && rule.selectorText === PREVIEW_SELECTOR) {
				return rule;
			}

			if (rule instanceof CSSGroupingRule) {
				const nested = findPreviewRule(rule.cssRules);
				if (nested) {
					return nested;
				}
			}
		}

		return null;
	};

	let cachedPreviewRule: CSSStyleRule | null = null;

	const getPreviewRule = (): CSSStyleRule | null => {
		if (cachedPreviewRule instanceof CSSStyleRule) {
			return cachedPreviewRule;
		}

		for (const styleSheet of Array.from(document.styleSheets)) {
			try {
				const foundRule = findPreviewRule(styleSheet.cssRules);
				if (foundRule instanceof CSSStyleRule) {
					cachedPreviewRule = foundRule;
					return cachedPreviewRule;
				}
			} catch {
				// Ignore non-readable cross-origin stylesheets.
			}
		}

		return null;
	};

	const toDisplayDate = (timestamp: number): string => {
		return new Date(timestamp).toLocaleString('es-ES', {
			year: 'numeric',
			month: 'short',
			day: '2-digit',
			hour: '2-digit',
			minute: '2-digit'
		});
	};

	const openHistoryDatabase = (): Promise<IDBDatabase> => {
		return new Promise<IDBDatabase>((resolve, reject) => {
			if (!('indexedDB' in window)) {
				reject(new Error('IndexedDB no esta disponible en este navegador.'));
				return;
			}

			const request = indexedDB.open(HISTORY_DB_NAME, 1);

			request.onupgradeneeded = () => {
				const database = request.result;
				if (!database.objectStoreNames.contains(HISTORY_STORE_NAME)) {
					database.createObjectStore(HISTORY_STORE_NAME, { keyPath: 'id' });
				}
			};

			request.onsuccess = () => resolve(request.result);
			request.onerror = () => reject(request.error ?? new Error('No se pudo abrir IndexedDB.'));
		});
	};

	const readHistoryEntries = async (): Promise<HistoryEntry[]> => {
		const database = await openHistoryDatabase();
		return await new Promise<HistoryEntry[]>((resolve, reject) => {
			const transaction = database.transaction(HISTORY_STORE_NAME, 'readonly');
			const store = transaction.objectStore(HISTORY_STORE_NAME);
			const request = store.getAll();

			request.onsuccess = () => {
				const entries = Array.isArray(request.result) ? (request.result as HistoryEntry[]) : [];
				entries.sort((left, right) => (right.createdAt ?? 0) - (left.createdAt ?? 0));
				resolve(entries);
			};
			request.onerror = () => reject(request.error ?? new Error('No se pudo leer el historial.'));

			transaction.oncomplete = () => {
				database.close();
			};
			transaction.onabort = () => {
				database.close();
			};
			transaction.onerror = () => {
				database.close();
			};
		});
	};

	const writeHistoryEntry = async (entry: HistoryEntry): Promise<void> => {
		const database = await openHistoryDatabase();
		return await new Promise<void>((resolve, reject) => {
			const transaction = database.transaction(HISTORY_STORE_NAME, 'readwrite');
			const store = transaction.objectStore(HISTORY_STORE_NAME);

			store.put(entry);
			const readRequest = store.getAll();
			readRequest.onsuccess = () => {
				const allEntries = Array.isArray(readRequest.result)
					? (readRequest.result as HistoryEntry[])
					: [];
				allEntries.sort((left, right) => (right.createdAt ?? 0) - (left.createdAt ?? 0));
				const overflowEntries = allEntries.slice(HISTORY_MAX_ENTRIES);
				for (const overflowEntry of overflowEntries) {
					if (typeof overflowEntry?.id === 'string') {
						store.delete(overflowEntry.id);
					}
				}
			};

			transaction.oncomplete = () => {
				database.close();
				resolve();
			};
			transaction.onerror = () => {
				database.close();
				reject(transaction.error ?? new Error('No se pudo guardar el historial.'));
			};
			transaction.onabort = () => {
				database.close();
				reject(transaction.error ?? new Error('La operacion de historial fue cancelada.'));
			};
		});
	};

	const clearHistoryEntries = async (): Promise<void> => {
		const database = await openHistoryDatabase();
		return await new Promise<void>((resolve, reject) => {
			const transaction = database.transaction(HISTORY_STORE_NAME, 'readwrite');
			const store = transaction.objectStore(HISTORY_STORE_NAME);
			store.clear();

			transaction.oncomplete = () => {
				database.close();
				resolve();
			};
			transaction.onerror = () => {
				database.close();
				reject(transaction.error ?? new Error('No se pudo limpiar el historial.'));
			};
			transaction.onabort = () => {
				database.close();
				reject(transaction.error ?? new Error('La limpieza de historial fue cancelada.'));
			};
		});
	};

	const renderHistory = () => {
		historyList.innerHTML = '';
		historyEmpty.hidden = historyEntries.length > 0;
		historyClearButton.disabled = historyEntries.length === 0;

		for (const entry of historyEntries) {
			const item = document.createElement('li');
			item.dataset.uploadHistoryItem = '';

			const meta = document.createElement('div');
			meta.dataset.historyMeta = '';

			const fileName = document.createElement('p');
			fileName.dataset.historyFile = '';
			fileName.textContent = entry.sourceFileName || entry.safeFileName || 'CV sin nombre';

			const info = document.createElement('p');
			info.dataset.historyInfo = '';
			const sizeLabel =
				typeof entry.inputSizeInBytes === 'number'
					? ` | ${(entry.inputSizeInBytes / 1024).toFixed(1)} KB`
					: '';
			info.textContent = `${(entry.format || 'txt').toUpperCase()} | ${toDisplayDate(entry.createdAt)}${sizeLabel}`;

			meta.append(fileName, info);

			const loadButton = document.createElement('button');
			loadButton.type = 'button';
			loadButton.dataset.historyLoadButton = '';
			loadButton.dataset.historyLoadId = entry.id;
			loadButton.textContent = 'Cargar version';

			item.append(meta, loadButton);
			historyList.appendChild(item);
		}
	};

	const refreshHistory = async () => {
		try {
			const entries = await readHistoryEntries();
			historyEntries = entries;
			renderHistory();
		} catch (error) {
			historyEntries = [];
			renderHistory();
			console.error('No se pudo cargar el historial local.', error);
		}
	};

	const saveCurrentVersionToHistory = async ({
		sourceFileName,
		safeFileName,
		format,
		inputSizeInBytes,
		inputFile,
		summary,
		contentHash,
		optimizedHTML,
		primaryColor
	}: SaveHistoryPayload): Promise<string> => {
		const safeOptimizedHtml = sanitizeCvHtml(optimizedHTML);
		if (!safeOptimizedHtml.trim()) {
			throw new Error('No se puede guardar una version no segura o vacia.');
		}

		const historyId = crypto.randomUUID();

		await writeHistoryEntry({
			id: historyId,
			createdAt: Date.now(),
			sourceFileName,
			safeFileName,
			format,
			inputSizeInBytes,
			inputFile,
			summary,
			contentHash,
			optimizedHTML: safeOptimizedHtml,
			primaryColor
		});
		await refreshHistory();
		return historyId;
	};

	const setStatus = (tone: StatusTone, title: string, message: string): void => {
		statusContainer.hidden = false;
		statusContainer.dataset.tone = tone;
		statusTitle.textContent = title;
		statusMessage.textContent = message;
	};

	const clearLogs = () => {
		stageNodes.clear();
		activeStageKey = null;
		statusLogList.innerHTML = '';
	};

	const setRetryAvailability = (isVisible: boolean): void => {
		retryButton.hidden = !isVisible;
	};

	const appendLog = (text: string, state: StageState): void => {
		const item = document.createElement('li');
		item.dataset.uploadLogItem = '';
		item.dataset.state = state;
		item.textContent = text;
		statusLogList.appendChild(item);
	};

	const getStageNode = (stageKey: StageKey): HTMLElement | null => {
		return stageNodes.get(stageKey) ?? null;
	};

	const startStage = (stageKey: StageKey): void => {
		const existing = getStageNode(stageKey);
		if (existing instanceof HTMLElement) {
			existing.dataset.state = 'en-progreso';
			activeStageKey = stageKey;
			return;
		}

		appendLog(PROCESS_STAGES[stageKey], 'en-progreso');
		const latestLog = statusLogList.lastElementChild;
		if (latestLog instanceof HTMLElement) {
			stageNodes.set(stageKey, latestLog);
			activeStageKey = stageKey;
		}
	};

	const completeStage = (stageKey: StageKey): void => {
		const stageNode = getStageNode(stageKey);
		if (!(stageNode instanceof HTMLElement)) {
			return;
		}

		stageNode.dataset.state = 'completado';
		if (activeStageKey === stageKey) {
			activeStageKey = null;
		}
	};

	const failActiveStage = (): void => {
		if (!activeStageKey) {
			return;
		}

		const stageNode = getStageNode(activeStageKey);
		if (stageNode instanceof HTMLElement) {
			stageNode.dataset.state = 'error';
		}

		activeStageKey = null;
	};

	const clearResult = () => {
		resultContainer.hidden = true;
		resultPreview.innerHTML = '';
		resultRaw.textContent = '';
	};

	const applyPreviewPrimaryColor = (color: string): void => {
		const safeColor = isValidHexColor(color) ? color : DEFAULT_PRIMARY_COLOR;
		const previewRule = getPreviewRule();
		if (!(previewRule instanceof CSSStyleRule)) {
			console.warn('No se pudo aplicar el color del preview: regla CSS no disponible.');
			return;
		}

		previewRule.style.setProperty('--cv-primary', safeColor);
	};

	const syncRawHtmlPanel = () => {
		resultRaw.textContent = resultPreview.innerHTML;
	};

	const toSafeFileName = (sourceName: string, extension: string): string => {
		const normalizedName = sourceName
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.replace(/[^a-zA-Z0-9-_]+/g, '-')
			.replace(/-{2,}/g, '-')
			.replace(/^-|-$/g, '')
			.toLowerCase();

		return `${normalizedName || 'cv-optimizado'}.${extension}`;
	};

	const downloadTextFile = (fileName: string, content: string, mimeType: string): void => {
		const blob = new Blob([content], { type: mimeType });
		const objectUrl = URL.createObjectURL(blob);
		const anchor = document.createElement('a');
		anchor.href = objectUrl;
		anchor.download = fileName;
		document.body.appendChild(anchor);
		anchor.click();
		anchor.remove();
		URL.revokeObjectURL(objectUrl);
	};

	const buildExportCss = (primaryColor: string): string => {
		return `
body {
	margin: 0;
	padding: 26px;
	font-family: "Manrope", "Avenir Next", "Segoe UI", sans-serif;
	color: #1a2a2f;
	background: #ffffff;
}
.cv-doc {
	line-height: 1.55;
	font-size: 15px;
	color: #41545c;
	--cv-primary: ${primaryColor};
}
.cv-doc h1 {
	margin: 0;
	font-size: 35px;
	line-height: 1.15;
	color: #1a2a2f;
}
.cv-doc h2 {
	margin: 22px 0 9px;
	padding-bottom: 5px;
	border-bottom: 2px solid color-mix(in srgb, var(--cv-primary), white 65%);
	font-size: 16px;
	text-transform: uppercase;
	color: var(--cv-primary);
}
.cv-doc h3 {
	margin: 16px 0 5px;
	font-size: 15px;
	color: color-mix(in srgb, var(--cv-primary), #1a2a2f 52%);
}
.cv-doc p {
	margin: 6px 0;
}
.cv-doc section {
	margin-top: 12px;
	padding-left: 12px;
	border-left: 3px solid color-mix(in srgb, var(--cv-primary), white 76%);
}
.cv-doc ul,
.cv-doc ol {
	margin: 8px 0 11px;
	padding-left: 17px;
}
.cv-doc li {
	margin: 3px 0;
}
.cv-doc strong {
	color: #1a2a2f;
}
.cv-doc .cv-placeholder {
	display: inline-block;
	margin: 0 2px;
	padding: 2px 6px;
	border-radius: 6px;
	font-weight: 800;
	letter-spacing: 0.01em;
}
.cv-doc .cv-placeholder-critical {
	color: #9f1239;
	background: #ffe4e6;
	border: 1px solid #fb7185;
}
.cv-doc a {
	color: color-mix(in srgb, var(--cv-primary), #0a3a35 18%);
	font-weight: 700;
	text-decoration: underline;
