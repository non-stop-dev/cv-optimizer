<section
	aria-labelledby="landing-hero-title"
	class="mx-auto h-[calc(100dvh-var(--nav-height))] max-w-[96rem] px-6 py-10 md:px-10 lg:px-12 lg:py-10"
>
	<div class="grid h-full items-center gap-12 lg:grid-cols-[minmax(0,0.76fr)_minmax(0,1.24fr)] lg:gap-16">
		<header class="flex max-w-xl flex-col justify-center">
			<p class="brutal-chip w-fit px-4 py-2">
				Documento 01 · Borrador Inestable
			</p>

			<h1
				id="landing-hero-title"
				class="mt-6 text-balance text-5xl font-black uppercase leading-[0.92] text-(--ink-strong) sm:text-6xl lg:text-7xl"
			>
				Empiezas, borras, vuelves a empezar.
			</h1>

			<p class="mt-6 max-w-lg text-lg leading-relaxed text-(--ink-soft) sm:text-xl">
				CV Optimizer toma ese borrador torpe, lo ordena y lo convierte en una versión clara,
				ATS-friendly y lista para editar.
			</p>

			<div class="mt-8 flex flex-wrap gap-4">
				<a href="#workflow" class="brutal-button brutal-button--mint">
					Ver El Flujo
				</a>
			</div>

			<p class="mt-5 max-w-md text-sm font-bold uppercase tracking-[0.18em] text-(--ink-soft)">
				Subes tu documento, la IA limpia la estructura y tú sales con una versión que ya parece
				enviable.
			</p>
		</header>

		<div class="grid content-center gap-6">
			<div class="grid items-end gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-8">
				<div class="grid gap-4">
					<aside class="brutal-note note-bob w-fit justify-self-center bg-(--note-yellow) px-5 py-4 lg:justify-self-start lg:ml-8">
						<p class="text-sm font-black uppercase tracking-[0.14em] text-(--ink-strong)">
							“Suena vacío”
						</p>
						<p class="mt-2 text-sm leading-relaxed text-(--ink-soft)">
							Demasiadas versiones.
							<br />
							Muy pocos logros reales.
						</p>
					</aside>

					<article
						class="brutal-paper paper-float w-[78%] justify-self-center rotate-[-4deg] px-6 py-7 sm:w-[60%] sm:px-8 sm:py-8 lg:w-full"
						aria-label="Borrador de CV con tachones"
					>
						<header class="relative z-10 border-b-2 border-dashed border-(--line) pb-5">
							<p class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.24em] text-(--ink-soft)">
								Borrador Manual
							</p>
							<h2 class="mt-3 text-3xl font-black uppercase leading-none text-(--ink-strong)">
								Juan SinTrabajo
							</h2>
							<div class="mt-4 space-y-3">
								<div class="draft-line h-3 w-[82%] rounded-full bg-neutral-900/85"></div>
								<div class="draft-line draft-line--late h-3 w-[74%] rounded-full bg-neutral-900/65"></div>
							</div>
						</header>

						<div class="relative z-10 mt-5 space-y-5">
							<section class="space-y-3">
								<div class="flex items-center justify-between gap-4">
									<p class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.24em] text-(--ink-soft)">
										Experiencia
									</p>
									<span class="rounded-full border-2 border-(--line) bg-white px-2 py-1 font-mono text-[0.62rem] font-bold uppercase tracking-[0.18em] text-(--ink-soft)">
										Rehacer
									</span>
								</div>
								<div class="space-y-3">
									<div class="draft-line draft-line--later h-3 w-[68%] rounded-full bg-neutral-900/80"></div>
									<div class="relative">
										<div class="draft-line draft-line--latest h-3 w-[88%] rounded-full bg-neutral-900/52"></div>
										<div class="draft-scribble absolute left-0 top-[0.36rem] h-[0.3rem] w-[92%] rounded-full bg-(--accent-red)"></div>
									</div>
									<div class="draft-line h-3 w-[62%] rounded-full bg-neutral-900/38"></div>
									<div class="draft-line draft-line--late h-3 w-[70%] rounded-full bg-neutral-900/72"></div>
								</div>
							</section>

							<section class="space-y-3 border-t-2 border-dashed border-(--line) pt-5">
								<p class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.24em] text-(--ink-soft)">
									Habilidades
								</p>
								<div class="flex flex-wrap gap-2">
									<span class="rounded-full border-2 border-(--line) px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-(--ink-soft)">
										Responsable
									</span>
									<span class="rounded-full border-2 border-(--line) px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-(--ink-soft)">
										Trabajadora
									</span>
									<span class="rounded-full border-2 border-(--line) bg-(--paper-muted) px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-(--accent-red)">
										Muy Genérico
									</span>
								</div>
							</section>
						</div>
					</article>
				</div>

				<div class="grid gap-4">
					<article
						class="brutal-paper w-[78%] justify-self-center rotate-[3deg] bg-white px-6 py-7 sm:w-[60%] sm:px-8 sm:py-8 lg:w-full"
						aria-label="Vista previa de CV optimizado"
					>
						<header class="relative z-10 border-b-2 border-(--line) pb-4">
							<p class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.24em] text-(--brand-optimizer)">
								Versión Optimizada
							</p>
							<h2 class="mt-3 text-3xl font-black uppercase leading-none text-(--ink-strong)">
								Juan SinTrabajo
							</h2>
							<p class="mt-3 max-w-xs text-sm leading-relaxed text-(--ink-soft)">
								Product Designer enfocada en research, sistemas y resultados medibles.
							</p>

							<div
								class="clean-stamp absolute right-2 top-[5.5rem] inline-flex rotate-[-14deg] border-[3px] border-(--brand-optimizer) px-4 py-2 font-mono text-xs font-black uppercase tracking-[0.24em] text-(--brand-optimizer) sm:right-4 sm:top-24"
								aria-hidden="true"
							>
								ATS Ready
							</div>
						</header>

						<div class="relative z-10 mt-5 space-y-5">
							<section class="space-y-3">
								<p class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.24em] text-(--ink-soft)">
									Logros destacados
								</p>
								<div class="space-y-3">
									<div class="h-3 w-[86%] rounded-full bg-neutral-900"></div>
									<div class="h-3 w-[72%] rounded-full bg-neutral-900/70"></div>
									<div class="h-3 w-[78%] rounded-full bg-neutral-900/55"></div>
								</div>
							</section>

							<section class="grid gap-3 sm:grid-cols-2">
								<div class="border-2 border-(--line) bg-(--paper-muted) px-4 py-3">
									<p class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.22em] text-(--ink-soft)">
										ATS
									</p>
									<p class="mt-2 text-sm font-extrabold uppercase text-(--ink-strong)">
										Texto limpio
									</p>
								</div>
								<div class="border-2 border-(--line) bg-white px-4 py-3">
									<p class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.22em] text-(--ink-soft)">
										Edición
									</p>
									<p class="mt-2 text-sm font-extrabold uppercase text-(--ink-strong)">
										Lista para ajustar
									</p>
								</div>
							</section>
						</div>
					</article>

					<footer class="mt-8 flex flex-col items-center gap-3 lg:mt-16 lg:items-start lg:pl-14">
						<p class="brutal-chip bg-white px-4 py-2">
							Paso lógico
						</p>
						<a href="/optimizer" class="brutal-button brutal-button--accent">
							Optimizar Este Borrador
							<span aria-hidden="true">↗</span>
						</a>
					</footer>
				</div>
			</div>
		</div>
	</div>
</section>
