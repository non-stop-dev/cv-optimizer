		--problem-rule-shift: 0.72rem;
		--problem-copy-offset: 0.54rem;
		padding-top: calc(var(--problem-rule-step) * 0.9);
		padding-bottom: calc(var(--problem-rule-step) * 1.1);
	}

	.problem-paper::before {
		background-position:
			0 0,
			0 var(--problem-rule-shift);
	}

	.problem-paper__header {
		padding-bottom: calc(var(--problem-rule-step) * 1.2);
	}

	.problem-paper__headline {
		max-width: 12ch;
		font-size: clamp(3.25rem, 6vw, 5.2rem);
		line-height: 0.9;
		letter-spacing: -0.055em;
	}

	.problem-paper__list {
		margin-top: calc(var(--problem-rule-step) * 0.95);
	}

	.problem-paper__row {
		display: grid;
		gap: 1rem;
		padding-block: calc(var(--problem-rule-step) * 1.02);
	}

	.problem-paper__eyebrow {
		padding-top: 0.45rem;
		line-height: 1;
	}

	.problem-paper__content {
		padding-top: 0.2rem;
	}

	.problem-paper__title {
		line-height: 0.98;
		text-wrap: balance;
	}

	.problem-paper__copy {
		max-width: 35rem;
		margin-top: var(--problem-copy-offset);
		line-height: var(--problem-rule-step);
		text-wrap: pretty;
	}

	@media (min-width: 640px) {
		.problem-paper {
			padding-top: calc(var(--problem-rule-step) * 1.05);
		}

		.problem-paper__row {
			grid-template-columns: 10.5rem minmax(0, 1fr);
			align-items: start;
		}
	}

	@media (min-width: 1024px) {
		.problem-paper__headline {
			max-width: 18ch;
		}

		.problem-paper__copy {
			max-width: 39rem;
		}
	}
