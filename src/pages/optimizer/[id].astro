---
import ImportantInformation from '../../components/disclosures/ImportantInformation.astro';
import NavBar from '../../components/nav-bar/NavBar.astro';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { id } = Astro.params;
const safeEntryId = typeof id === 'string' ? id : '';
---

<Layout title="CV Optimizer | Resultado optimizado">
	<main class="relative min-h-screen pb-16 bg-white">
		<NavBar />
		<section class="relative mx-auto w-full max-w-5xl px-6 pb-8 pt-12 md:px-10 md:pb-14 md:pt-16">
			<div class="fade-up relative overflow-hidden rounded-[2rem] border border-(--line) bg-white/82 p-8 shadow-[0_20px_48px_rgba(18,35,38,0.1)] md:p-12">
				<div class="pointer-events-none absolute -right-20 top-[-72px] h-56 w-56 rounded-full bg-[radial-gradient(circle,_rgba(222,60,75,0.2)_0%,_transparent_68%)]"></div>
				<div class="pointer-events-none absolute -left-24 bottom-[-110px] h-64 w-64 rounded-full bg-[radial-gradient(circle,_rgba(15,118,110,0.18)_0%,_transparent_68%)]"></div>

				<div class="relative space-y-6" data-output-root data-entry-id={safeEntryId}>
					<div class="flex flex-wrap items-center justify-between gap-3">
						<a
							href="/optimizer"
							class="inline-flex items-center justify-center rounded-lg border border-(--line) bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
						>
							Volver
						</a>
						<p data-output-meta class="text-sm text-(--ink-soft)">Cargando version...</p>
					</div>

					<aside
						data-output-status
						hidden
						class="w-full rounded-2xl border border-(--line) bg-white/80 p-5 text-left text-sm text-(--ink-strong)"
						aria-live="polite"
					>
						<h3 data-output-status-title class="text-base font-bold"></h3>
						<p data-output-status-message class="mt-2 text-(--ink-soft)"></p>
					</aside>

					<section
						data-output-result
						hidden
						class="w-full rounded-2xl border border-(--line) bg-white/85 p-5 text-left"
					>
						<h3 class="text-base font-bold text-(--ink-strong)">CV optimizado por IA</h3>
						<div data-cv-editor-controls class="mt-3 flex flex-wrap items-center gap-3">
							<label
								for="cv-primary-color"
								class="inline-flex items-center gap-2 rounded-lg border border-(--line) bg-white px-3 py-2 text-xs font-semibold uppercase tracking-[0.08em] text-(--ink-soft)"
							>
								Color principal
								<input
									id="cv-primary-color"
									type="color"
									value="#0f766e"
									data-cv-primary-color
									class="h-7 w-7 cursor-pointer rounded border-0 bg-transparent p-0"
								/>
							</label>
							<button
								type="button"
								data-cv-export-html
								class="inline-flex items-center justify-center rounded-lg border border-(--line) bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
							>
								Exportar HTML
							</button>
							<button
								type="button"
								data-cv-export-txt
								class="inline-flex items-center justify-center rounded-lg border border-(--line) bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
							>
								Exportar TXT
							</button>
							<button
								type="button"
								data-cv-export-pdf
								class="group relative inline-flex items-center justify-center gap-2 rounded-lg border border-(--line) bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--brand-optimizer)"
							>
								<span>Exportar PDF</span>
								<span
									data-pdf-help-trigger
									aria-hidden="true"
									class="inline-flex h-4 w-4 items-center justify-center text-(--ink-soft)"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="14"
										height="14"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="lucide lucide-info"
									>
										<circle cx="12" cy="12" r="10"></circle>
										<path d="M12 16v-4"></path>
										<path d="M12 8h.01"></path>
									</svg>
								</span>
								<span
									data-pdf-help-tooltip
									role="tooltip"
									class="pointer-events-none invisible absolute left-1/2 top-full z-20 mt-2 w-72 -translate-x-1/2 rounded-lg border border-(--line) bg-white px-3 py-2 text-[11px] normal-case font-medium tracking-normal leading-relaxed text-(--ink-soft) opacity-0 shadow-[0_12px_24px_rgba(12,22,26,0.12)] transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
								>
									La exportacion PDF se realiza mediante la vista de impresion del navegador. Si no se abre automaticamente,
									usa Cmd/Ctrl+P y guarda como PDF.
								</span>
							</button>
						</div>
						<p class="mt-2 text-xs text-(--ink-soft)">
							Vista editable: puedes ajustar texto y estructura antes de exportar.
						</p>
						<div
							data-output-preview
							contenteditable="true"
							spellcheck="true"
							class="mt-3 max-h-[70vh] overflow-auto rounded-xl border border-(--line) bg-white p-6 text-sm text-(--ink-strong)"
						></div>
						<details class="mt-3">
							<summary class="cursor-pointer text-sm font-semibold text-(--ink-soft)">Ver HTML generado</summary>
							<pre
								data-output-raw
								class="mt-2 max-h-64 overflow-auto rounded-xl border border-(--line) bg-white p-3 text-xs text-(--ink-soft)"
							></pre>
						</details>
					</section>
				</div>
			</div>
		</section>
		<ImportantInformation />
	</main>
</Layout>

<style is:global>
	[data-output-status][data-tone='proceso'] {
		border-color: color-mix(in srgb, var(--brand-optimizer), white 35%);
		background: color-mix(in srgb, var(--brand-optimizer), white 92%);
	}

	[data-output-status][data-tone='exito'] {
		border-color: color-mix(in srgb, var(--brand-optimizer), white 20%);
		background: color-mix(in srgb, var(--brand-optimizer), white 88%);
	}

	[data-output-status][data-tone='error'] {
		border-color: color-mix(in srgb, var(--brand-cv), white 20%);
		background: color-mix(in srgb, var(--brand-cv), white 90%);
	}

	[data-output-preview] {
		--cv-primary: #0f766e;
		--cv-ink: #1a2a2f;
		--cv-soft: #41545c;
		line-height: 1.55;
		font-size: 0.98rem;
		color: var(--cv-ink);
	}

	[data-output-preview]:focus {
		outline: 2px solid color-mix(in srgb, var(--cv-primary), white 38%);
		outline-offset: 2px;
	}

	[data-output-preview] h1 {
		margin: 0;
		font-size: clamp(1.8rem, 2.6vw, 2.35rem);
		line-height: 1.15;
		color: var(--cv-ink);
	}

	[data-output-preview] h2 {
		margin: 1.35rem 0 0.55rem;
		padding-bottom: 0.35rem;
		border-bottom: 2px solid color-mix(in srgb, var(--cv-primary), white 65%);
		font-size: 1.06rem;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		color: var(--cv-primary);
	}

	[data-output-preview] h3 {
		margin: 1rem 0 0.3rem;
		font-size: 1.02rem;
		color: color-mix(in srgb, var(--cv-primary), var(--cv-ink) 52%);
	}

	[data-output-preview] p {
		margin: 0.35rem 0;
		color: var(--cv-soft);
	}

	[data-output-preview] section {
		margin-top: 1rem;
		padding-left: 0.8rem;
		border-left: 3px solid color-mix(in srgb, var(--cv-primary), white 76%);
	}

	[data-output-preview] ul,
	[data-output-preview] ol {
		margin: 0.45rem 0 0.75rem;
		padding-left: 1.1rem;
	}

	[data-output-preview] li {
		margin: 0.2rem 0;
		color: var(--cv-soft);
	}

	[data-output-preview] strong {
		color: var(--cv-ink);
	}

	[data-output-preview] .cv-placeholder {
		display: inline-block;
		margin: 0 0.15rem;
		padding: 0.1rem 0.42rem;
		border-radius: 0.35rem;
		font-weight: 800;
		letter-spacing: 0.01em;
	}

	[data-output-preview] .cv-placeholder-critical {
		color: #9f1239;
		background: #ffe4e6;
		border: 1px solid #fb7185;
	}

	[data-output-preview] a {
		color: color-mix(in srgb, var(--cv-primary), #0a3a35 18%);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	[data-output-preview] hr {
		margin: 1rem 0;
		border: 0;
		border-top: 1px solid color-mix(in srgb, var(--cv-primary), white 70%);
	}
</style>

<script>
	import DOMPurify from 'dompurify';

	const HISTORY_DB_NAME = 'cv-optimizer-browser-memory';
	const HISTORY_STORE_NAME = 'cv-history';
	const PREVIEW_SELECTOR = '[data-output-preview]';
	const DEFAULT_PRIMARY_COLOR = '#0f766e';

	type StatusTone = 'proceso' | 'exito' | 'error';

	interface HistoryEntry {
		id: string;
		createdAt: number;
		sourceFileName: string;
		safeFileName: string;
		format: string;
		inputSizeInBytes: number;
		inputFile?: File;
		summary: string;
		contentHash: string;
		optimizedHTML: string;
		primaryColor: string;
	}

	const CV_SANITIZE_CONFIG = {
		ALLOWED_TAGS: [
			'h1',
			'h2',
			'h3',
			'h4',
			'h5',
			'h6',
			'p',
			'div',
			'span',
			'section',
			'article',
			'strong',
			'em',
			'b',
			'i',
			'u',
			'ul',
			'ol',
			'li',
			'br',
			'hr',
			'a',
			'table',
			'thead',
			'tbody',
			'tr',
			'th',
			'td'
		],
		ALLOWED_ATTR: ['href', 'title', 'target', 'rel', 'class'],
		ALLOW_DATA_ATTR: false,
		ALLOW_UNKNOWN_PROTOCOLS: false,
		ALLOWED_URI_REGEXP: /^(?:(?:https?|mailto|tel):|[^a-z]|[a-z+.-]+(?:[^a-z+.-:]|$))/i
	};

	const root = document.querySelector('[data-output-root]');
	const statusContainer = document.querySelector('[data-output-status]');
	const statusTitle = document.querySelector('[data-output-status-title]');
	const statusMessage = document.querySelector('[data-output-status-message]');
	const outputMeta = document.querySelector('[data-output-meta]');
	const resultContainer = document.querySelector('[data-output-result]');
	const resultPreview = document.querySelector('[data-output-preview]');
	const resultRaw = document.querySelector('[data-output-raw]');
	const cvPrimaryColorPicker = document.querySelector('[data-cv-primary-color]');
	const exportHtmlButton = document.querySelector('[data-cv-export-html]');
	const exportTxtButton = document.querySelector('[data-cv-export-txt]');
	const exportPdfButton = document.querySelector('[data-cv-export-pdf]');

	if (
		!(root instanceof HTMLElement) ||
		!(statusContainer instanceof HTMLElement) ||
		!(statusTitle instanceof HTMLElement) ||
		!(statusMessage instanceof HTMLElement) ||
		!(outputMeta instanceof HTMLElement) ||
		!(resultContainer instanceof HTMLElement) ||
		!(resultPreview instanceof HTMLElement) ||
		!(resultRaw instanceof HTMLElement) ||
		!(cvPrimaryColorPicker instanceof HTMLInputElement) ||
		!(exportHtmlButton instanceof HTMLButtonElement) ||
		!(exportTxtButton instanceof HTMLButtonElement) ||
		!(exportPdfButton instanceof HTMLButtonElement)
	) {
		throw new Error('No se pudo inicializar la vista dedicada del CV optimizado.');
	}

	const entryId = root.dataset.entryId;
	let currentDocumentBaseName = 'cv-optimizado';

	const setStatus = (tone: StatusTone, title: string, message: string): void => {
		statusContainer.hidden = false;
		statusContainer.dataset.tone = tone;
		statusTitle.textContent = title;
		statusMessage.textContent = message;
	};

	const sanitizeCvHtml = (html: string): string => {
		if (typeof html !== 'string' || html.length === 0) {
			return '';
		}
		return DOMPurify.sanitize(html, CV_SANITIZE_CONFIG);
	};

	const isValidHexColor = (value: string): boolean => {
		return /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(value);
	};

	const findPreviewRule = (rules: CSSRuleList): CSSStyleRule | null => {
		for (const rule of Array.from(rules)) {
			if (rule instanceof CSSStyleRule && rule.selectorText === PREVIEW_SELECTOR) {
				return rule;
			}

			if (rule instanceof CSSGroupingRule) {
				const nested = findPreviewRule(rule.cssRules);
				if (nested) {
					return nested;
				}
			}
		}
		return null;
	};

	let cachedPreviewRule: CSSStyleRule | null = null;

	const getPreviewRule = (): CSSStyleRule | null => {
		if (cachedPreviewRule instanceof CSSStyleRule) {
			return cachedPreviewRule;
		}

		for (const styleSheet of Array.from(document.styleSheets)) {
			try {
				const foundRule = findPreviewRule(styleSheet.cssRules);
				if (foundRule instanceof CSSStyleRule) {
					cachedPreviewRule = foundRule;
					return cachedPreviewRule;
				}
			} catch {
				// Ignore non-readable cross-origin stylesheets.
			}
		}

		return null;
	};

	const applyPreviewPrimaryColor = (color: string): void => {
		const safeColor = isValidHexColor(color) ? color : DEFAULT_PRIMARY_COLOR;
		const previewRule = getPreviewRule();
		if (!(previewRule instanceof CSSStyleRule)) {
			console.warn('No se pudo aplicar el color del preview: regla CSS no disponible.');
			return;
		}

		previewRule.style.setProperty('--cv-primary', safeColor);
	};

	const syncRawHtmlPanel = () => {
		resultRaw.textContent = resultPreview.innerHTML;
	};

	const toSafeFileName = (sourceName: string, extension: string): string => {
		const normalizedName = sourceName
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.replace(/[^a-zA-Z0-9-_]+/g, '-')
			.replace(/-{2,}/g, '-')
			.replace(/^-|-$/g, '')
			.toLowerCase();

		return `${normalizedName || 'cv-optimizado'}.${extension}`;
	};

	const downloadTextFile = (fileName: string, content: string, mimeType: string): void => {
		const blob = new Blob([content], { type: mimeType });
		const objectUrl = URL.createObjectURL(blob);
		const anchor = document.createElement('a');
		anchor.href = objectUrl;
		anchor.download = fileName;
		document.body.appendChild(anchor);
		anchor.click();
		anchor.remove();
		URL.revokeObjectURL(objectUrl);
	};

	const buildExportCss = (primaryColor: string): string => {
		return `
body {
	margin: 0;
	padding: 26px;
	font-family: "Manrope", "Avenir Next", "Segoe UI", sans-serif;
	color: #1a2a2f;
	background: #ffffff;
}
.cv-doc {
	line-height: 1.55;
	font-size: 15px;
	color: #41545c;
	--cv-primary: ${primaryColor};
}
.cv-doc h1 {
	margin: 0;
	font-size: 35px;
	line-height: 1.15;
	color: #1a2a2f;
}
.cv-doc h2 {
	margin: 22px 0 9px;
	padding-bottom: 5px;
	border-bottom: 2px solid color-mix(in srgb, var(--cv-primary), white 65%);
	font-size: 16px;
	text-transform: uppercase;
	color: var(--cv-primary);
}
.cv-doc h3 {
	margin: 16px 0 5px;
	font-size: 15px;
	color: color-mix(in srgb, var(--cv-primary), #1a2a2f 52%);
}
.cv-doc p {
	margin: 6px 0;
}
.cv-doc section {
	margin-top: 12px;
	padding-left: 12px;
	border-left: 3px solid color-mix(in srgb, var(--cv-primary), white 76%);
}
.cv-doc ul,
.cv-doc ol {
	margin: 8px 0 11px;
	padding-left: 17px;
}
.cv-doc li {
	margin: 3px 0;
}
.cv-doc strong {
	color: #1a2a2f;
}
.cv-doc .cv-placeholder {
	display: inline-block;
	margin: 0 2px;
	padding: 2px 6px;
	border-radius: 6px;
	font-weight: 800;
	letter-spacing: 0.01em;
}
.cv-doc .cv-placeholder-critical {
	color: #9f1239;
	background: #ffe4e6;
	border: 1px solid #fb7185;
}
.cv-doc a {
	color: color-mix(in srgb, var(--cv-primary), #0a3a35 18%);
	font-weight: 700;
	text-decoration: underline;
}
`;
	};

	const openHistoryDatabase = (): Promise<IDBDatabase> => {
		return new Promise<IDBDatabase>((resolve, reject) => {
			if (!('indexedDB' in window)) {
				reject(new Error('IndexedDB no esta disponible en este navegador.'));
				return;
			}

			const request = indexedDB.open(HISTORY_DB_NAME, 1);
			request.onupgradeneeded = () => {
				const database = request.result;
				if (!database.objectStoreNames.contains(HISTORY_STORE_NAME)) {
					database.createObjectStore(HISTORY_STORE_NAME, { keyPath: 'id' });
				}
			};
			request.onsuccess = () => resolve(request.result);
			request.onerror = () => reject(request.error ?? new Error('No se pudo abrir IndexedDB.'));
		});
	};

	const readHistoryEntryById = async (historyId: string): Promise<HistoryEntry | null> => {
		const database = await openHistoryDatabase();
		return await new Promise<HistoryEntry | null>((resolve, reject) => {
			const transaction = database.transaction(HISTORY_STORE_NAME, 'readonly');
			const store = transaction.objectStore(HISTORY_STORE_NAME);
			const request = store.get(historyId);

			request.onsuccess = () => {
				const result = request.result;
				resolve(result && typeof result === 'object' ? (result as HistoryEntry) : null);
			};
			request.onerror = () => reject(request.error ?? new Error('No se pudo leer la version solicitada.'));

			transaction.oncomplete = () => {
				database.close();
			};
			transaction.onabort = () => {
				database.close();
			};
			transaction.onerror = () => {
				database.close();
			};
		});
	};

	const showResult = (optimizedHTML: string): void => {
		const safeOptimizedHtml = sanitizeCvHtml(optimizedHTML);
		if (!safeOptimizedHtml.trim()) {
			throw new Error('El contenido optimizado no paso la sanitizacion del navegador.');
		}

		resultContainer.hidden = false;
		resultPreview.innerHTML = safeOptimizedHtml;
		applyPreviewPrimaryColor(cvPrimaryColorPicker.value);
		syncRawHtmlPanel();
	};

	const loadEntry = async (): Promise<void> => {
		if (typeof entryId !== 'string' || entryId.length === 0) {
			setStatus('error', 'ID invalido', 'La URL no contiene un identificador de version valido.');
			outputMeta.textContent = 'Version no encontrada.';
			return;
		}

		setStatus('proceso', 'Cargando version', 'Recuperando contenido desde historial local.');

		try {
			const entry = await readHistoryEntryById(entryId);
			if (!entry) {
				setStatus(
					'error',
					'No se encontro la version',
					'Esta version no existe en tu historial local o fue eliminada.'
				);
				outputMeta.textContent = 'Version no disponible.';
				return;
			}

			if (typeof entry.optimizedHTML !== 'string' || entry.optimizedHTML.length === 0) {
				setStatus(
					'error',
					'Contenido invalido',
					'La version guardada no contiene HTML optimizado valido.'
				);
				outputMeta.textContent = 'Version invalida.';
				return;
			}

			currentDocumentBaseName =
				(entry.sourceFileName || entry.safeFileName || 'cv-optimizado').replace(/\.[^.]+$/, '');

			const selectedColor =
				typeof entry.primaryColor === 'string' && entry.primaryColor.length > 0
					? entry.primaryColor
					: DEFAULT_PRIMARY_COLOR;
			cvPrimaryColorPicker.value = selectedColor;
			showResult(entry.optimizedHTML);
			applyPreviewPrimaryColor(selectedColor);

			const sourceName = entry.sourceFileName || entry.safeFileName || 'CV sin nombre';
			outputMeta.textContent = `Version: ${sourceName}`;
			setStatus('exito', 'Version lista', 'Puedes editar el CV y exportarlo en el formato que prefieras.');
		} catch (error) {
			console.error('No se pudo cargar la version dedicada.', error);
			setStatus('error', 'Error al cargar', 'No se pudo recuperar esta version local.');
			outputMeta.textContent = 'Error de carga.';
		}
	};

	resultPreview.addEventListener('input', syncRawHtmlPanel);

	cvPrimaryColorPicker.addEventListener('input', (event) => {
		const target = event.currentTarget;
		if (!(target instanceof HTMLInputElement)) {
			return;
		}
		applyPreviewPrimaryColor(target.value);
	});

	exportHtmlButton.addEventListener('click', () => {
		if (!resultPreview.innerHTML.trim()) {
			setStatus('error', 'No hay contenido para exportar', 'Edita o carga un CV antes de exportar.');
			return;
		}

		const primaryColor = cvPrimaryColorPicker.value;
		const safeEditorHtml = sanitizeCvHtml(resultPreview.innerHTML);
		const cvMarkup = `<article class="cv-doc">${safeEditorHtml}</article>`;
		const htmlDocument = `<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CV optimizado</title>
  <style>${buildExportCss(primaryColor)}</style>
</head>
<body>
${cvMarkup}
</body>
</html>`;

		const fileName = toSafeFileName(currentDocumentBaseName, 'html');
		downloadTextFile(fileName, htmlDocument, 'text/html;charset=utf-8');
	});

	exportTxtButton.addEventListener('click', () => {
		const plainText = resultPreview.innerText.trim();
		if (!plainText) {
			setStatus('error', 'No hay contenido para exportar', 'Edita o carga un CV antes de exportar.');
			return;
		}

		const fileName = toSafeFileName(currentDocumentBaseName, 'txt');
		downloadTextFile(fileName, plainText, 'text/plain;charset=utf-8');
	});

	exportPdfButton.addEventListener('click', () => {
		if (!resultPreview.innerHTML.trim()) {
			setStatus('error', 'No hay contenido para exportar', 'Edita o carga un CV antes de exportar.');
			return;
		}

		const primaryColor = cvPrimaryColorPicker.value;
		const safeEditorHtml = sanitizeCvHtml(resultPreview.innerHTML);
		const printableHtml = `<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CV optimizado</title>
  <style>${buildExportCss(primaryColor)}</style>
</head>
<body>
  <article class="cv-doc">${safeEditorHtml}</article>
</body>
</html>`;
		const printableBlob = new Blob([printableHtml], { type: 'text/html;charset=utf-8' });
		const printableUrl = URL.createObjectURL(printableBlob);

		const printWindow = window.open(printableUrl, '_blank');
		if (!printWindow) {
			URL.revokeObjectURL(printableUrl);
			setStatus(
				'error',
				'No se pudo abrir la vista de impresion',
				'Tu navegador bloqueó la ventana emergente. Habilita pop-ups e intenta nuevamente.'
			);
			return;
		}

		setStatus(
			'proceso',
			'PDF listo para imprimir',
			'Se abrió una pestaña de impresión. Si no aparece el diálogo automático, usa Cmd/Ctrl+P para guardar como PDF.'
		);

		const releasePrintableUrl = () => {
			URL.revokeObjectURL(printableUrl);
		};

		const triggerNativePrint = () => {
			printWindow.focus();
			try {
				printWindow.print();
			} catch (printError) {
				console.warn('No se pudo lanzar impresion automatica. Usa Cmd/Ctrl+P manualmente.', printError);
			}
		};

		printWindow.addEventListener(
			'load',
			() => {
				triggerNativePrint();
			},
			{ once: true }
		);
		printWindow.addEventListener(
			'afterprint',
			() => {
				releasePrintableUrl();
				printWindow.close();
			},
			{ once: true }
		);

		setTimeout(() => {
			releasePrintableUrl();
		}, 120000);
	});

	loadEntry();
</script>
