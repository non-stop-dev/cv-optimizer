---
import ImportantInformation from '../../components/disclosures/ImportantInformation.astro';
import NavBar from '../../components/nav-bar/NavBar.astro';
import Layout from '../../layouts/Layout.astro';
import { CV_TEMPLATE_OPTIONS } from '../../styles/cv-templates/cv-template-options';
import '../../styles/cv-templates/cv-preview-templates.css';

export const prerender = false;

const { id } = Astro.params;
const safeEntryId = typeof id === 'string' ? id : '';
---

<Layout title="CV Optimizer | Resultado optimizado">
	<main class="landing-page relative min-h-screen pb-16">
		<NavBar />
		<section class="landing-shell relative px-6 pb-8 pt-12 md:px-10 md:pb-14 md:pt-16">
			<div class="fade-up brutal-paper px-6 py-7 sm:px-8 sm:py-8 md:px-10 md:py-10">
				<div class="pointer-events-none absolute -right-20 -top-18 h-56 w-56 rounded-full bg-[radial-gradient(circle,rgba(222,60,75,0.2)_0%,transparent_68%)]"></div>
				<div class="pointer-events-none absolute -left-24 -bottom-27.5 h-64 w-64 rounded-full bg-[radial-gradient(circle,rgba(15,118,110,0.18)_0%,transparent_68%)]"></div>

				<div
					class="relative space-y-6"
					data-output-root
					data-entry-id={safeEntryId}
				>
					<div class="flex flex-wrap items-center justify-between gap-3">
						<a
							href="/optimizer"
							class="brutal-button px-4 py-2 text-xs uppercase tracking-[0.08em]"
						>
							Volver
						</a>
						<div class="flex flex-col items-end text-right">
							<p data-output-meta class="text-sm text-(--ink-soft)">Cargando versión...</p>
							<p data-output-save-indicator data-state="idle" class="mt-1 text-xs text-(--ink-soft)">
								Autoguardado desactivado.
							</p>
						</div>
					</div>

					<aside
						data-output-status
						hidden
						class="brutal-card w-full p-5 text-left text-sm text-(--ink-strong)"
						aria-live="polite"
					>
						<h3 data-output-status-title class="text-base font-bold"></h3>
						<p data-output-status-message class="mt-2 text-(--ink-soft)"></p>
					</aside>

					<section
						data-output-result
						hidden
						class="w-full text-left"
					>
						<h3 class="font-mono text-[0.72rem] font-black uppercase tracking-[0.24em] text-(--brand-optimizer)">
							CV optimizado por IA
						</h3>
						<div class="mt-3 space-y-2">
							<div data-cv-action-controls class="flex flex-wrap items-center gap-2">
								<button
									type="button"
									data-cv-translate-en
									class="brutal-control group h-9 shrink-0 gap-2 px-4 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) disabled:cursor-not-allowed disabled:opacity-55"
								>
									<span data-cv-translate-en-label>Traducir al inglés</span>
									<span class="relative inline-flex h-4 w-4 items-center justify-center text-(--ink-soft)">
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="14"
											height="14"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="lucide lucide-info"
											aria-hidden="true"
										>
											<circle cx="12" cy="12" r="10"></circle>
											<path d="M12 16v-4"></path>
											<path d="M12 8h.01"></path>
										</svg>
											<span
												data-cv-translate-source-tooltip
												role="tooltip"
												class="brutal-tooltip pointer-events-none absolute left-1/2 top-[calc(100%+0.65rem)] z-20 w-56 -translate-x-1/2 px-2 py-1 text-[10px] font-medium normal-case tracking-normal text-(--ink-soft) opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100"
											>
												Traduce el CV al inglés.
											</span>
										</span>
									</button>
								<div data-cv-export-shell class="relative shrink-0">
									<button
										type="button"
										data-cv-export-trigger
										aria-haspopup="menu"
										aria-expanded="false"
										class="brutal-control h-9 gap-2 px-4 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
									>
										<span>Exportar</span>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="14"
											height="14"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="m6 9 6 6 6-6"></path>
										</svg>
									</button>
									<div
										data-cv-export-list
										hidden
										role="menu"
										class="brutal-tooltip absolute left-0 top-[calc(100%+0.65rem)] z-20 flex min-w-40 flex-col gap-1 p-1"
									>
										<button
											type="button"
											data-cv-export-option="html"
											role="menuitem"
											class="brutal-control h-8 justify-start px-3 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
										>
											Exportar HTML
										</button>
										<button
											type="button"
											data-cv-export-option="txt"
											role="menuitem"
											class="brutal-control h-8 justify-start px-3 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
										>
											Exportar TXT
										</button>
										<button
											type="button"
											data-cv-export-option="pdf"
											role="menuitem"
											class="brutal-control h-8 justify-start px-3 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong)"
										>
											Exportar PDF
										</button>
									</div>
								</div>
							</div>
							<div data-cv-editor-controls class="flex items-center gap-2 overflow-x-auto pb-1">
							<label
								for="cv-primary-color"
								class="brutal-control h-9 shrink-0 gap-2 px-3 text-xs font-semibold uppercase tracking-[0.08em] text-(--ink-soft)"
							>
								<span>Color principal</span>
								<input
									id="cv-primary-color"
									type="color"
									value="#0f766e"
									data-cv-primary-color
									class="h-6 w-6 cursor-pointer appearance-none rounded border border-(--line) bg-transparent p-0"
								/>
							</label>
							<label
								for="cv-template-select"
								class="brutal-control h-9 shrink-0 gap-2 px-3 text-xs font-semibold uppercase tracking-[0.08em] text-(--ink-soft)"
							>
								<span>Plantilla</span>
								<select
									id="cv-template-select"
									data-cv-template-select
									class="h-6 border-2 border-(--line) bg-white px-2 text-[11px] font-bold uppercase tracking-[0.08em] text-(--ink-strong) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--brand-optimizer)"
								>
									{CV_TEMPLATE_OPTIONS.map((template) => (
										<option value={template.id}>{template.label}</option>
									))}
								</select>
							</label>
							<button
								type="button"
								data-cv-undo
								class="brutal-control h-9 w-9 shrink-0 text-(--ink-strong) disabled:cursor-not-allowed disabled:opacity-55"
								aria-label="Deshacer"
								title="Deshacer"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="lucide lucide-undo-2"
								>
									<path d="M9 14 4 9l5-5"></path>
									<path d="M4 9h10a4 4 0 1 1 0 8h-1"></path>
								</svg>
							</button>
							<button
								type="button"
								data-cv-redo
								class="brutal-control h-9 w-9 shrink-0 text-(--ink-strong) disabled:cursor-not-allowed disabled:opacity-55"
								aria-label="Rehacer"
								title="Rehacer"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="lucide lucide-redo-2"
								>
									<path d="m15 14 5-5-5-5"></path>
									<path d="M20 9H10a4 4 0 0 0 0 8h1"></path>
								</svg>
							</button>
							<button
								type="button"
								data-cv-format-bold
								class="brutal-control h-9 w-9 shrink-0 text-sm font-bold text-(--ink-strong)"
								aria-label="Negrita"
								title="Negrita"
							>
								B
							</button>
							<button
								type="button"
								data-cv-format-italic
								class="brutal-control h-9 w-9 shrink-0 text-sm italic font-semibold text-(--ink-strong)"
								aria-label="Cursiva"
								title="Cursiva"
							>
								I
							</button>
							<button
								type="button"
								data-cv-format-underline
								class="brutal-control h-9 w-9 shrink-0 text-sm font-semibold underline text-(--ink-strong)"
								aria-label="Subrayado"
								title="Subrayado"
							>
								U
							</button>
							<button
								type="button"
								data-cv-format-link
								class="brutal-control h-9 w-9 shrink-0 text-(--ink-strong)"
								aria-label="Insertar enlace"
								title="Insertar enlace"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="lucide lucide-link"
								>
									<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07L11.93 5"></path>
									<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07L12.07 19"></path>
								</svg>
							</button>
							</div>
						</div>
						<p class="mt-2 text-xs text-(--ink-soft)">
							Vista editable: puedes ajustar texto y estructura antes de exportar.
						</p>
						<div
							data-output-preview
							contenteditable="true"
							spellcheck="true"
							class="mt-3 max-h-[70vh] overflow-auto border-2 border-(--line) bg-white p-6 text-sm text-(--ink-strong) shadow-[6px_6px_0_var(--shadow)]"
						></div>
						<pre data-output-raw hidden></pre>
					</section>
				</div>
			</div>
		</section>
		<ImportantInformation />
	</main>
</Layout>

<style is:global>
	[data-output-status][data-tone='proceso'] {
		border-color: color-mix(in srgb, var(--brand-optimizer), white 35%);
		background: color-mix(in srgb, var(--brand-optimizer), white 92%);
	}

	[data-output-status][data-tone='exito'] {
		border-color: color-mix(in srgb, var(--brand-optimizer), white 20%);
		background: color-mix(in srgb, var(--brand-optimizer), white 88%);
	}

	[data-output-status][data-tone='error'] {
		border-color: color-mix(in srgb, var(--brand-cv), white 20%);
		background: color-mix(in srgb, var(--brand-cv), white 90%);
	}

	[data-output-save-indicator][data-state='saving'] {
		color: color-mix(in srgb, var(--brand-optimizer), #0b5e57 48%);
	}

	[data-output-save-indicator][data-state='saved'] {
		color: color-mix(in srgb, var(--brand-optimizer), #1c2a2f 30%);
	}

	[data-output-save-indicator][data-state='error'] {
		color: color-mix(in srgb, var(--brand-cv), #5a0d1f 30%);
	}

	[data-cv-undo]:disabled,
	[data-cv-redo]:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	[data-cv-primary-color]::-webkit-color-swatch-wrapper {
		padding: 0;
	}

	[data-cv-primary-color]::-webkit-color-swatch {
		border: 1px solid var(--line);
		border-radius: 0.3rem;
	}

	[data-cv-primary-color]::-moz-color-swatch {
		border: 1px solid var(--line);
		border-radius: 0.3rem;
	}
</style>

<script>
	import '../../server/browser-memory/optimizer-edition-view.client';
</script>
