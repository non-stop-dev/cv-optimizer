---
import ImportantInformation from '../../components/disclosures/ImportantInformation.astro';
import NavBar from '../../components/nav-bar/NavBar.astro';
import Layout from '../../layouts/Layout.astro';
import { CV_TEMPLATE_OPTIONS } from '../../server/export-cv/cv-export';

export const prerender = false;

const { id } = Astro.params;
const safeEntryId = typeof id === 'string' ? id : '';
const codingEnvironment = (import.meta.env.CODING_ENVIRONMENT ?? 'development').toLowerCase();
---

<Layout title="CV Optimizer | Resultado optimizado">
	<main class="relative min-h-screen pb-16 bg-white">
		<NavBar />
		<section class="relative mx-auto w-full max-w-5xl px-6 pb-8 pt-12 md:px-10 md:pb-14 md:pt-16">
			<div class="fade-up relative overflow-hidden rounded-4xl border border-(--line) bg-white/82 p-8 shadow-[0_20px_48px_rgba(18,35,38,0.1)] md:p-12">
				<div class="pointer-events-none absolute -right-20 -top-18 h-56 w-56 rounded-full bg-[radial-gradient(circle,rgba(222,60,75,0.2)_0%,transparent_68%)]"></div>
				<div class="pointer-events-none absolute -left-24 -bottom-27.5 h-64 w-64 rounded-full bg-[radial-gradient(circle,rgba(15,118,110,0.18)_0%,transparent_68%)]"></div>

				<div
					class="relative space-y-6"
					data-output-root
					data-entry-id={safeEntryId}
					data-coding-environment={codingEnvironment}
				>
					<div class="flex flex-wrap items-center justify-between gap-3">
						<a
							href="/optimizer"
							class="inline-flex items-center justify-center rounded-lg border border-(--line) bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
						>
							Volver
						</a>
						<div class="flex flex-col items-end text-right">
							<p data-output-meta class="text-sm text-(--ink-soft)">Cargando versión...</p>
							<p data-output-save-indicator data-state="idle" class="mt-1 text-xs text-(--ink-soft)">
								Autoguardado desactivado.
							</p>
						</div>
					</div>

					<aside
						data-output-status
						hidden
						class="w-full rounded-2xl border border-(--line) bg-white/80 p-5 text-left text-sm text-(--ink-strong)"
						aria-live="polite"
					>
						<h3 data-output-status-title class="text-base font-bold"></h3>
						<p data-output-status-message class="mt-2 text-(--ink-soft)"></p>
					</aside>

					<section
						data-output-result
						hidden
						class="w-full rounded-2xl border border-(--line) bg-white/85 p-5 text-left"
					>
						<h3 class="text-base font-bold text-(--ink-strong)">CV optimizado por IA</h3>
						<div class="mt-3 space-y-2">
							<div data-cv-action-controls class="flex items-center gap-2">
								<button
									type="button"
									data-cv-translate-en
									class="group inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-lg border border-(--line) bg-white px-4 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface) disabled:cursor-not-allowed disabled:opacity-55"
								>
									<span data-cv-translate-en-label>Traducir al inglés</span>
									<span class="relative inline-flex h-4 w-4 items-center justify-center text-(--ink-soft)">
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="14"
											height="14"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="lucide lucide-info"
											aria-hidden="true"
										>
											<circle cx="12" cy="12" r="10"></circle>
											<path d="M12 16v-4"></path>
											<path d="M12 8h.01"></path>
										</svg>
										<span
											data-cv-translate-source-tooltip
											role="tooltip"
											class="pointer-events-none absolute left-1/2 top-[calc(100%+0.45rem)] z-20 w-56 -translate-x-1/2 rounded-md border border-(--line) bg-white px-2 py-1 text-[10px] font-medium normal-case tracking-normal text-(--ink-soft) opacity-0 shadow-[0_8px_20px_rgba(12,22,26,0.16)] transition group-hover:opacity-100 group-focus-visible:opacity-100"
										>
											Detectando fuente de traducción...
										</span>
									</span>
								</button>
								<div data-cv-export-shell class="relative shrink-0">
									<button
										type="button"
										data-cv-export-trigger
										aria-haspopup="menu"
										aria-expanded="false"
										class="inline-flex h-9 items-center justify-center gap-2 rounded-lg border border-(--line) bg-white px-4 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
									>
										<span>Exportar</span>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="14"
											height="14"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="m6 9 6 6 6-6"></path>
										</svg>
									</button>
									<div
										data-cv-export-list
										hidden
										role="menu"
										class="absolute left-0 top-[calc(100%+0.35rem)] z-20 flex min-w-40 flex-col gap-1 rounded-lg border border-(--line) bg-white p-1 shadow-[0_12px_24px_rgba(12,22,26,0.12)]"
									>
										<button
											type="button"
											data-cv-export-option="html"
											role="menuitem"
											class="inline-flex h-8 items-center justify-start rounded-md px-3 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
										>
											Exportar HTML
										</button>
										<button
											type="button"
											data-cv-export-option="txt"
											role="menuitem"
											class="inline-flex h-8 items-center justify-start rounded-md px-3 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
										>
											Exportar TXT
										</button>
										<button
											type="button"
											data-cv-export-option="pdf"
											role="menuitem"
											class="inline-flex h-8 items-center justify-start rounded-md px-3 text-xs font-bold uppercase tracking-[0.08em] text-(--ink-strong) transition hover:bg-(--surface)"
										>
											Exportar PDF
										</button>
									</div>
								</div>
							</div>
							<div data-cv-editor-controls class="flex items-center gap-2 overflow-x-auto pb-1">
							<label
								for="cv-primary-color"
								class="inline-flex h-9 shrink-0 items-center gap-2 rounded-lg border border-(--line) bg-white px-3 text-xs font-semibold uppercase tracking-[0.08em] text-(--ink-soft)"
							>
								<span>Color principal</span>
								<input
									id="cv-primary-color"
									type="color"
									value="#0f766e"
									data-cv-primary-color
									class="h-6 w-6 cursor-pointer appearance-none rounded border border-(--line) bg-transparent p-0"
								/>
							</label>
							<label
								for="cv-template-select"
								class="inline-flex h-9 shrink-0 items-center gap-2 rounded-lg border border-(--line) bg-white px-3 text-xs font-semibold uppercase tracking-[0.08em] text-(--ink-soft)"
							>
								<span>Plantilla</span>
								<select
									id="cv-template-select"
									data-cv-template-select
									class="h-6 rounded border border-(--line) bg-white px-2 text-[11px] font-bold uppercase tracking-[0.08em] text-(--ink-strong) focus:outline-none"
								>
									{CV_TEMPLATE_OPTIONS.map((template) => (
										<option value={template.id}>{template.label}</option>
									))}
								</select>
							</label>
							<button
								type="button"
								data-cv-undo
								class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-(--line) bg-white text-(--ink-strong) transition hover:bg-(--surface) disabled:cursor-not-allowed disabled:opacity-55"
								aria-label="Deshacer"
								title="Deshacer"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="lucide lucide-undo-2"
								>
									<path d="M9 14 4 9l5-5"></path>
									<path d="M4 9h10a4 4 0 1 1 0 8h-1"></path>
								</svg>
							</button>
							<button
								type="button"
								data-cv-redo
								class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-(--line) bg-white text-(--ink-strong) transition hover:bg-(--surface) disabled:cursor-not-allowed disabled:opacity-55"
								aria-label="Rehacer"
								title="Rehacer"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="lucide lucide-redo-2"
								>
									<path d="m15 14 5-5-5-5"></path>
									<path d="M20 9H10a4 4 0 0 0 0 8h1"></path>
								</svg>
							</button>
							<button
								type="button"
								data-cv-format-bold
								class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-(--line) bg-white text-sm font-bold text-(--ink-strong) transition hover:bg-(--surface)"
								aria-label="Negrita"
								title="Negrita"
							>
								B
							</button>
							<button
								type="button"
								data-cv-format-italic
								class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-(--line) bg-white text-sm italic font-semibold text-(--ink-strong) transition hover:bg-(--surface)"
								aria-label="Cursiva"
								title="Cursiva"
							>
								I
							</button>
							<button
								type="button"
								data-cv-format-underline
								class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-(--line) bg-white text-sm underline font-semibold text-(--ink-strong) transition hover:bg-(--surface)"
								aria-label="Subrayado"
								title="Subrayado"
							>
								U
							</button>
							<button
								type="button"
								data-cv-format-link
								class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-(--line) bg-white text-(--ink-strong) transition hover:bg-(--surface)"
								aria-label="Insertar enlace"
								title="Insertar enlace"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="lucide lucide-link"
								>
									<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07L11.93 5"></path>
									<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07L12.07 19"></path>
								</svg>
							</button>
							</div>
						</div>
						<p class="mt-2 text-xs text-(--ink-soft)">
							Vista editable: puedes ajustar texto y estructura antes de exportar.
						</p>
						<div
							data-output-preview
							contenteditable="true"
							spellcheck="true"
							class="mt-3 max-h-[70vh] overflow-auto rounded-xl border border-(--line) bg-white p-6 text-sm text-(--ink-strong)"
						></div>
						<details class="mt-3">
							<summary class="cursor-pointer text-sm font-semibold text-(--ink-soft)">Ver HTML generado</summary>
							<pre
								data-output-raw
								class="mt-2 max-h-64 overflow-auto rounded-xl border border-(--line) bg-white p-3 text-xs text-(--ink-soft)"
							></pre>
						</details>
					</section>
				</div>
			</div>
		</section>
		<ImportantInformation />
	</main>
</Layout>

<style is:global>
	[data-output-status][data-tone='proceso'] {
		border-color: color-mix(in srgb, var(--brand-optimizer), white 35%);
		background: color-mix(in srgb, var(--brand-optimizer), white 92%);
	}

	[data-output-status][data-tone='exito'] {
		border-color: color-mix(in srgb, var(--brand-optimizer), white 20%);
		background: color-mix(in srgb, var(--brand-optimizer), white 88%);
	}

	[data-output-status][data-tone='error'] {
		border-color: color-mix(in srgb, var(--brand-cv), white 20%);
		background: color-mix(in srgb, var(--brand-cv), white 90%);
	}

	[data-output-save-indicator][data-state='saving'] {
		color: color-mix(in srgb, var(--brand-optimizer), #0b5e57 48%);
	}

	[data-output-save-indicator][data-state='saved'] {
		color: color-mix(in srgb, var(--brand-optimizer), #1c2a2f 30%);
	}

	[data-output-save-indicator][data-state='error'] {
		color: color-mix(in srgb, var(--brand-cv), #5a0d1f 30%);
	}

	[data-output-preview] {
		--cv-primary: #0f766e;
		--cv-ink: #1a2a2f;
		--cv-soft: #41545c;
		--cv-font-family: "Manrope", "Avenir Next", "Segoe UI", sans-serif;
		--cv-font-size: 0.98rem;
		--cv-line-height: 1.55;
		--cv-h1-size: clamp(1.8rem, 2.6vw, 2.35rem);
		--cv-h1-line-height: 1.15;
		--cv-h1-transform: none;
		--cv-h1-letter-spacing: normal;
		--cv-h2-margin: 1.35rem 0 0.55rem;
		--cv-h2-padding-bottom: 0.35rem;
		--cv-h2-size: 1.06rem;
		--cv-h2-transform: uppercase;
		--cv-h2-letter-spacing: 0.01em;
		--cv-h2-border-bottom: 2px solid color-mix(in srgb, var(--cv-primary), white 65%);
		--cv-h3-margin: 1rem 0 0.3rem;
		--cv-h3-size: 1.02rem;
		--cv-h3-color: color-mix(in srgb, var(--cv-primary), var(--cv-ink) 52%);
		--cv-paragraph-margin: 0.35rem 0;
		--cv-section-margin-top: 1rem;
		--cv-section-padding-left: 0.8rem;
		--cv-section-padding-top: 0;
		--cv-section-border-left: 3px solid color-mix(in srgb, var(--cv-primary), white 76%);
		--cv-section-border-top: none;
		--cv-list-margin: 0.45rem 0 0.75rem;
		--cv-list-padding-left: 1.1rem;
		--cv-list-item-margin: 0.2rem 0;
		--cv-link-color: color-mix(in srgb, var(--cv-primary), #0a3a35 18%);
		--cv-link-weight: 700;
		font-family: var(--cv-font-family);
		line-height: var(--cv-line-height);
		font-size: var(--cv-font-size);
		color: var(--cv-ink);
	}

	[data-output-preview][data-cv-template='executive'] {
		--cv-font-family: "Sora", "Manrope", "Avenir Next", "Segoe UI", sans-serif;
		--cv-font-size: 0.94rem;
		--cv-line-height: 1.5;
		--cv-h1-size: clamp(1.9rem, 2.8vw, 2.45rem);
		--cv-h1-line-height: 1.12;
		--cv-h1-transform: uppercase;
		--cv-h1-letter-spacing: 0.06em;
		--cv-h2-margin: 1.5rem 0 0.5rem;
		--cv-h2-padding-bottom: 0.3rem;
		--cv-h2-size: 0.86rem;
		--cv-h2-letter-spacing: 0.16em;
		--cv-h2-border-bottom: 1px solid color-mix(in srgb, var(--cv-primary), white 72%);
		--cv-h3-margin: 0.9rem 0 0.2rem;
		--cv-h3-size: 0.96rem;
		--cv-h3-color: #1f3138;
		--cv-paragraph-margin: 0.28rem 0;
		--cv-section-margin-top: 1.1rem;
		--cv-section-padding-left: 0;
		--cv-section-padding-top: 0.6rem;
		--cv-section-border-left: none;
		--cv-section-border-top: 1px solid color-mix(in srgb, var(--cv-primary), white 75%);
		--cv-list-margin: 0.35rem 0 0.65rem;
		--cv-list-padding-left: 1rem;
		--cv-list-item-margin: 0.15rem 0;
		--cv-link-color: color-mix(in srgb, var(--cv-primary), #10313a 36%);
	}

	[data-output-preview][data-cv-template='minimal'] {
		--cv-font-size: 0.93rem;
		--cv-line-height: 1.5;
		--cv-h1-size: clamp(1.72rem, 2.45vw, 2.18rem);
		--cv-h2-margin: 1.2rem 0 0.42rem;
		--cv-h2-padding-bottom: 0.28rem;
		--cv-h2-size: 0.8rem;
		--cv-h2-letter-spacing: 0.19em;
		--cv-h2-border-bottom: 1px solid color-mix(in srgb, var(--cv-primary), white 72%);
		--cv-h3-margin: 0.82rem 0 0.18rem;
		--cv-h3-size: 0.92rem;
		--cv-h3-color: #25343b;
		--cv-paragraph-margin: 0.22rem 0;
		--cv-section-margin-top: 0.85rem;
		--cv-section-padding-left: 0.6rem;
		--cv-section-border-left: 2px solid color-mix(in srgb, var(--cv-primary), white 79%);
		--cv-list-margin: 0.3rem 0 0.6rem;
		--cv-list-padding-left: 0.9rem;
		--cv-list-item-margin: 0.1rem 0;
		--cv-link-color: color-mix(in srgb, var(--cv-primary), #14363f 28%);
	}

	[data-output-preview][data-cv-template='serif'] {
		--cv-font-family: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
		--cv-font-size: 1rem;
		--cv-line-height: 1.6;
		--cv-h1-size: clamp(1.86rem, 2.6vw, 2.3rem);
		--cv-h1-letter-spacing: 0.01em;
		--cv-h2-margin: 1.35rem 0 0.52rem;
		--cv-h2-padding-bottom: 0.3rem;
		--cv-h2-size: 1rem;
		--cv-h2-transform: none;
		--cv-h2-letter-spacing: 0.01em;
		--cv-h2-border-bottom: 1px solid color-mix(in srgb, var(--cv-primary), white 65%);
		--cv-h3-size: 1rem;
		--cv-h3-color: #27343b;
		--cv-section-padding-left: 0.9rem;
		--cv-section-border-left: 3px double color-mix(in srgb, var(--cv-primary), white 72%);
		--cv-list-padding-left: 1.18rem;
		--cv-link-weight: 600;
	}

	[data-output-preview]:focus {
		outline: 2px solid color-mix(in srgb, var(--cv-primary), white 38%);
		outline-offset: 2px;
	}

	[data-output-preview] h1 {
		margin: 0;
		font-size: var(--cv-h1-size);
		line-height: var(--cv-h1-line-height);
		text-transform: var(--cv-h1-transform);
		letter-spacing: var(--cv-h1-letter-spacing);
		color: var(--cv-ink);
	}

	[data-output-preview] h2 {
		margin: var(--cv-h2-margin);
		padding-bottom: var(--cv-h2-padding-bottom);
		border-bottom: var(--cv-h2-border-bottom);
		font-size: var(--cv-h2-size);
		letter-spacing: var(--cv-h2-letter-spacing);
		text-transform: var(--cv-h2-transform);
		color: var(--cv-primary);
	}

	[data-output-preview] h3 {
		margin: var(--cv-h3-margin);
		font-size: var(--cv-h3-size);
		color: var(--cv-h3-color);
	}

	[data-output-preview] p {
		margin: var(--cv-paragraph-margin);
		color: var(--cv-soft);
	}

	[data-output-preview] section {
		margin-top: var(--cv-section-margin-top);
		padding-top: var(--cv-section-padding-top);
		padding-left: var(--cv-section-padding-left);
		border-top: var(--cv-section-border-top);
		border-left: var(--cv-section-border-left);
	}

	[data-output-preview] ul,
	[data-output-preview] ol {
		margin: var(--cv-list-margin);
		padding-left: var(--cv-list-padding-left);
	}

	[data-output-preview] ul {
		list-style: disc;
	}

	[data-output-preview] ol {
		list-style: decimal;
	}

	[data-output-preview] li {
		margin: var(--cv-list-item-margin);
		color: var(--cv-soft);
	}

	[data-output-preview] strong {
		color: var(--cv-ink);
	}

	[data-output-preview] .cv-placeholder {
		display: inline-block;
		margin: 0 0.15rem;
		padding: 0.1rem 0.42rem;
		border-radius: 0.35rem;
		font-weight: 800;
		letter-spacing: 0.01em;
	}

	[data-output-preview] .cv-placeholder-critical {
		color: #9f1239;
		background: #ffe4e6;
		border: 1px solid #fb7185;
	}

	[data-output-preview] a {
		color: var(--cv-link-color);
		font-weight: var(--cv-link-weight);
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	[data-output-preview] hr {
		margin: 1rem 0;
		border: 0;
		border-top: 1px solid color-mix(in srgb, var(--cv-primary), white 70%);
	}

	[data-cv-undo]:disabled,
	[data-cv-redo]:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	[data-cv-primary-color]::-webkit-color-swatch-wrapper {
		padding: 0;
	}

	[data-cv-primary-color]::-webkit-color-swatch {
		border: 1px solid var(--line);
		border-radius: 0.3rem;
	}

	[data-cv-primary-color]::-moz-color-swatch {
		border: 1px solid var(--line);
		border-radius: 0.3rem;
	}
